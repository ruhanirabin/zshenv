# =============================================================================
# .zshrc.example — Custom .zshrc template for zshenv
# =============================================================================
# Copy this file to ~/.zshrc.custom and source it at the bottom of .zshrc
# to add personal customisations that survive re-runs of zshenv-install.
#
# The installer does NOT overwrite existing .zshrc files that contain
# the "Generated by zshenv-install" header -- it checks and skips.
# (This is a future feature; currently .zshrc is always overwritten.)
# =============================================================================

# ── Personal aliases ────────────────────────────────────────────────────────
alias ll='ls -la'
alias ..='cd ..'

# ── Custom PATH additions ───────────────────────────────────────────────────
# export PATH="$HOME/bin:$HOME/.local/bin:$PATH"

# ── Custom environment variables ────────────────────────────────────────────
# export EDITOR=nano
