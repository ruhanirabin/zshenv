#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2026 Ruhani Rabin (Rabin)
# =============================================================================
# bin/zshenv-install — Automated ZSH + Oh My Zsh + Atuin environment installer
# =============================================================================
# Multi-user capable. Idempotent. Non-interactive. Backup + rollback support.
#
# Usage:
#   sudo bin/zshenv-install                    # Current user ($SUDO_USER or $USER)
#   sudo bin/zshenv-install --user alice       # Specific user
#   sudo bin/zshenv-install --user alice,bob   # Multiple users
#   sudo bin/zshenv-install --all              # All users with UID >= 1000
#   sudo bin/zshenv-install --dry-run          # Print what would be done
#   bin/zshenv-install version                 # Show version
# =============================================================================
set -euo pipefail

# ── Version (single source of truth: ../VERSION) ────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION_FILE="${SCRIPT_DIR}/../VERSION"
if [[ -f "$VERSION_FILE" ]]; then
  ZSHENV_VERSION="$(tr -d '[:space:]' < "$VERSION_FILE")"
else
  ZSHENV_VERSION="unknown"
fi

# ── Colours ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'
BOLD='\033[1m'; NC='\033[0m'
log_info()  { echo -e "${CYAN}[INFO]${NC}  $*"; }
log_ok()    { echo -e "${GREEN}[OK]${NC}    $*"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC}  $*"; }
log_err()   { echo -e "${RED}[ERR]${NC}   $*"; }

# ── Globals ──────────────────────────────────────────────────────────────────
DRY_RUN=false
TARGET_USERS=()
BACKUP_DIR=""
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
ROLLBACK_SCRIPT=""

# ── Plugin definitions ───────────────────────────────────────────────────────
# Key: plugin directory name | Value: git clone URL
declare -A PLUGINS=(
  ["zsh-autosuggestions"]="https://github.com/zsh-users/zsh-autosuggestions.git"
  ["zsh-syntax-highlighting"]="https://github.com/zsh-users/zsh-syntax-highlighting.git"
)

# ── .zshrc template ─────────────────────────────────────────────────────────
ZSHRC_TEMPLATE='
# ═══════════════════════════════════════════════════════════════════════════
# .zshrc — Generated by zshenv-install v{VERSION}
# Theme: fino-time | Plugins: git, zsh-autosuggestions, zsh-syntax-highlighting
# History: Atuin (sync enabled)
# ═══════════════════════════════════════════════════════════════════════════

# ── PATH (uncomment if needed) ──────────────────────────────────────────────
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# ── Oh My Zsh Theme ─────────────────────────────────────────────────────────
ZSH_THEME="fino-time"

# ── Auto-update settings ────────────────────────────────────────────────────
zstyle '"'"':omz:update'"'"' mode auto        # update automatically without asking
zstyle '"'"':omz:update'"'"' frequency 13     # check every 13 days

# ── Completion & correction ─────────────────────────────────────────────────
ENABLE_CORRECTION="true"
COMPLETION_WAITING_DOTS="true"

# ── Plugins ─────────────────────────────────────────────────────────────────
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

# ── Completion behaviour ────────────────────────────────────────────────────
zstyle '"'"':completion:*'"'"' menu select          # arrow-key navigation in tab menu
zstyle '"'"':completion:*'"'"' matcher-list '"'"'m:{a-zA-Z}={A-Za-z}'"'"'  # case-insensitive

# ── Load Oh My Zsh ──────────────────────────────────────────────────────────
source $ZSH/oh-my-zsh.sh

# ── Personal aliases ────────────────────────────────────────────────────────
alias zshconfig="nano ~/.zshrc"
alias ohmyzsh="nano ~/.oh-my-zsh"

# ── Atuin (shell history sync) ──────────────────────────────────────────────
[[ -f "$HOME/.atuin/bin/env" ]] && . "$HOME/.atuin/bin/env"
eval "$(atuin init zsh)"
'

# ── Parse args ───────────────────────────────────────────────────────────────
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --user)
        if [[ -z "${2:-}" ]]; then
          log_err "--user requires a username argument"
          exit 1
        fi
        IFS=',' read -ra TARGET_USERS <<< "$2"
        shift 2
        ;;
      --all)
        TARGET_USERS=("__ALL__")
        shift
        ;;
      --dry-run)
        DRY_RUN=true
        shift
        ;;
      version|--version|-v)
        echo "zshenv-install ${ZSHENV_VERSION}"
        exit 0
        ;;
      --help|-h)
        echo "Usage: $0 [--user user1,user2] [--all] [--dry-run] [version]"
        echo ""
        echo "Options:"
        echo "  --user u1,u2   Install for specific user(s)"
        echo "  --all          Install for all non-system users (UID >= 1000)"
        echo "  --dry-run      Print actions without executing"
        echo "  version        Show version"
        exit 0
        ;;
      *)
        log_err "Unknown option: $1"
        exit 1
        ;;
    esac
  done
}

# ── Resolve target users ─────────────────────────────────────────────────────
resolve_users() {
  if [[ ${#TARGET_USERS[@]} -eq 0 ]]; then
    if [[ $EUID -eq 0 && -n "${SUDO_USER:-}" ]]; then
      TARGET_USERS=("$SUDO_USER")
    else
      TARGET_USERS=("$USER")
    fi
  elif [[ "${TARGET_USERS[0]}" == "__ALL__" ]]; then
    TARGET_USERS=()
    while IFS=: read -r username _ _ _ _ home _; do
      local uid
      uid=$(id -u "$username" 2>/dev/null || echo 9999)
      if [[ $uid -ge 1000 && "$username" != "nobody" ]]; then
        TARGET_USERS+=("$username")
      fi
    done < /etc/passwd
  fi
  log_info "Target users: ${TARGET_USERS[*]}"
}

# ── Step 0: Check required dependencies ──────────────────────────────────────
check_dependencies() {
  log_info "Checking required dependencies..."
  local missing=()

  for cmd in git curl; do
    if ! command -v "$cmd" &>/dev/null; then
      missing+=("$cmd")
    fi
  done

  if [[ ${#missing[@]} -eq 0 ]]; then
    log_ok "All dependencies satisfied: git, curl"
    return 0
  fi

  log_warn "Missing dependencies: ${missing[*]}"

  if $DRY_RUN; then
    log_info "[DRY-RUN] Would run: apt-get install -y ${missing[*]}"
    return 0
  fi

  # Prompt user for confirmation
  echo ""
  echo -e "${YELLOW}[PROMPT]${NC}  The following packages are required: ${missing[*]}"
  echo "         Run: apt-get install -y ${missing[*]}"
  echo ""
  read -rp "Install now? [Y/n] " response
  case "${response:-Y}" in
    [Yy]*|"")
      log_info "Installing: ${missing[*]}..."
      apt-get update -qq
      apt-get install -y -qq "${missing[@]}"
      for cmd in "${missing[@]}"; do
        if command -v "$cmd" &>/dev/null; then
          log_ok "$cmd installed: $($cmd --version 2>/dev/null | head -1)"
        else
          log_err "$cmd installation failed"
          return 1
        fi
      done
      ;;
    *)
      log_err "Dependencies not installed -- cannot continue"
      return 1
      ;;
  esac
}

# ── Step 1: Distro compatibility ─────────────────────────────────────────────
check_distro() {
  log_info "Checking distro compatibility..."
  if [[ -f /etc/os-release ]]; then
    local id_like id
    id_like=$(grep -E '^ID_LIKE=' /etc/os-release | cut -d= -f2 | tr -d '"' || true)
    id=$(grep -E '^ID=' /etc/os-release | cut -d= -f2 | tr -d '"' || true)

    if [[ "$id" == "ubuntu" || "$id" == "debian" || "$id_like" == *"debian"* || "$id_like" == *"ubuntu"* ]]; then
      log_ok "Compatible distro detected: $id"
      return 0
    fi
  fi
  if command -v apt-get &>/dev/null || command -v dpkg &>/dev/null; then
    log_ok "Debian/Ubuntu package manager detected"
    return 0
  fi
  log_err "This script requires Ubuntu/Debian-based distros"
  return 1
}

# ── Step 2: Install ZSH ──────────────────────────────────────────────────────
install_zsh() {
  log_info "Installing ZSH..."
  if command -v zsh &>/dev/null; then
    log_ok "ZSH already installed: $(zsh --version)"
    return 0
  fi

  if $DRY_RUN; then
    log_info "[DRY-RUN] Would run: apt-get update && apt-get install -y zsh"
    return 0
  fi

  apt-get update -qq
  apt-get install -y -qq zsh
  if command -v zsh &>/dev/null; then
    log_ok "ZSH installed: $(zsh --version)"
  else
    log_err "ZSH installation failed"
    return 1
  fi
}

# ── Step 3: Set ZSH as default shell ─────────────────────────────────────────
set_default_shell() {
  local user="$1"
  local zsh_path
  zsh_path=$(command -v zsh)

  # Ensure zsh is in /etc/shells (required for chsh)
  if ! grep -q "$zsh_path" /etc/shells 2>/dev/null; then
    if $DRY_RUN; then
      log_info "[DRY-RUN] Would add $zsh_path to /etc/shells"
    else
      echo "$zsh_path" >> /etc/shells
      log_info "Added zsh to /etc/shells"
    fi
  fi

  if $DRY_RUN; then
    log_info "[DRY-RUN] Would set default shell for $user to $zsh_path"
    return 0
  fi

  local current_shell
  current_shell=$(getent passwd "$user" | cut -d: -f7)
  if [[ "$current_shell" == *"zsh"* ]]; then
    log_ok "$user already uses ZSH"
    return 0
  fi

  chsh -s "$zsh_path" "$user" 2>/dev/null || \
    usermod -s "$zsh_path" "$user" 2>/dev/null || {
    log_err "Failed to change shell for $user"
    return 1
  }
  log_ok "Default shell for $user set to $zsh_path"
}

# ── Step 4: Install Oh My Zsh (non-interactive) ──────────────────────────────
install_ohmyzsh() {
  local user="$1"
  local user_home
  user_home=$(eval echo "~$user")

  if [[ -d "$user_home/.oh-my-zsh" ]]; then
    log_ok "Oh My Zsh already installed for $user"
    return 0
  fi

  if $DRY_RUN; then
    log_info "[DRY-RUN] Would install Oh My Zsh for $user"
    return 0
  fi

  log_info "Installing Oh My Zsh for $user (non-interactive)..."

  # Primary: pipe install script with env vars set
  su - "$user" -c 'curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh | RUNZSH=no CHSH=no sh -s -- --unattended' 2>&1 || {
    # Fallback: download then execute
    log_warn "Primary OMZ install failed, trying fallback..."
    local tmpfile
    tmpfile=$(mktemp)
    curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh -o "$tmpfile"
    su - "$user" -c "RUNZSH=no CHSH=no bash $tmpfile --unattended" 2>&1
    rm -f "$tmpfile"
  }

  if [[ -d "$user_home/.oh-my-zsh" ]]; then
    log_ok "Oh My Zsh installed for $user"
  else
    log_err "Oh My Zsh installation failed for $user"
    return 1
  fi
}

# ── Step 5: Clone plugins ────────────────────────────────────────────────────
install_plugins() {
  local user="$1"
  local user_home
  user_home=$(eval echo "~$user")
  local zsh_custom="$user_home/.oh-my-zsh/custom"

  for plugin_name in "${!PLUGINS[@]}"; do
    local plugin_url="${PLUGINS[$plugin_name]}"
    local plugin_dir="$zsh_custom/plugins/$plugin_name"

    if [[ -d "$plugin_dir" ]]; then
      log_ok "Plugin $plugin_name already installed for $user"
      continue
    fi

    if $DRY_RUN; then
      log_info "[DRY-RUN] Would clone $plugin_name for $user"
      continue
    fi

    log_info "Cloning plugin: $plugin_name..."
    su - "$user" -c "git clone --depth 1 $plugin_url $plugin_dir" 2>&1 || {
      log_err "Failed to clone $plugin_name for $user"
      return 1
    }
    log_ok "Plugin $plugin_name installed for $user"
  done
}

# ── Step 6: Write .zshrc ─────────────────────────────────────────────────────
write_zshrc() {
  local user="$1"
  local user_home
  user_home=$(eval echo "~$user")
  local zshrc="$user_home/.zshrc"

  # Backup existing .zshrc
  if [[ -f "$zshrc" ]]; then
    local backup_file="${BACKUP_DIR}/${user}_zshrc_${TIMESTAMP}.bak"
    cp "$zshrc" "$backup_file"
    log_ok "Backed up $user .zshrc -> $backup_file"
  fi

  if $DRY_RUN; then
    log_info "[DRY-RUN] Would write .zshrc for $user"
    return 0
  fi

  # Inject version into template
  local rendered
  rendered="${ZSHRC_TEMPLATE//\{VERSION\}/$ZSHENV_VERSION}"

  echo "$rendered" > "$zshrc"
  chown "${user}:${user}" "$zshrc"
  chmod 644 "$zshrc"
  log_ok ".zshrc written for $user"
}

# ── Step 7: Install Atuin (non-interactive) ──────────────────────────────────
install_atuin() {
  local user="$1"
  local user_home
  user_home=$(eval echo "~$user")

  if [[ -x "$user_home/.atuin/bin/atuin" ]]; then
    log_ok "Atuin already installed for $user"
    return 0
  fi

  if $DRY_RUN; then
    log_info "[DRY-RUN] Would install Atuin for $user"
    return 0
  fi

  log_info "Installing Atuin for $user (non-interactive)..."
  su - "$user" -c 'curl --proto "=https" --tlsv1.2 -LsSf https://setup.atuin.sh | sh -s -- --non-interactive' 2>&1 || {
    log_err "Atuin installation failed for $user"
    return 1
  }

  if [[ -x "$user_home/.atuin/bin/atuin" ]]; then
    log_ok "Atuin installed for $user: $($user_home/.atuin/bin/atuin --version 2>/dev/null || echo 'installed')"
  else
    log_err "Atuin binary not found after install for $user"
    return 1
  fi
}

# ── Step 8: Validate ─────────────────────────────────────────────────────────
validate_install() {
  local user="$1"
  local user_home
  user_home=$(eval echo "~$user")
  local errors=0

  log_info "Validating installation for $user..."

  # Check .zshrc exists
  if [[ ! -f "$user_home/.zshrc" ]]; then
    log_err ".zshrc not found for $user"
    ((errors++))
  fi

  # Check OMZ
  if [[ ! -d "$user_home/.oh-my-zsh" ]]; then
    log_err "Oh My Zsh directory missing for $user"
    ((errors++))
  fi

  # Check plugins
  for plugin_name in "${!PLUGINS[@]}"; do
    if [[ ! -d "$user_home/.oh-my-zsh/custom/plugins/$plugin_name" ]]; then
      log_err "Plugin $plugin_name missing for $user"
      ((errors++))
    fi
  done

  # Check Atuin
  if [[ ! -x "$user_home/.atuin/bin/atuin" ]]; then
    log_err "Atuin binary missing for $user"
    ((errors++))
  fi

  # Check default shell
  local current_shell
  current_shell=$(getent passwd "$user" | cut -d: -f7)
  if [[ "$current_shell" != *"zsh"* ]]; then
    log_warn "Default shell for $user is still $current_shell (not zsh)"
  fi

  # Syntax-check .zshrc
  if [[ -f "$user_home/.zshrc" ]] && command -v zsh &>/dev/null; then
    local syntax_errors
    syntax_errors=$(zsh -n "$user_home/.zshrc" 2>&1 || true)
    if [[ -n "$syntax_errors" ]]; then
      log_err ".zshrc syntax errors for $user: $syntax_errors"
      ((errors++))
    else
      log_ok ".zshrc syntax OK for $user"
    fi
  fi

  if [[ $errors -eq 0 ]]; then
    log_ok "All validations passed for $user"
    return 0
  else
    log_err "$errors validation error(s) for $user"
    return 1
  fi
}

# ── Step 9: Generate rollback script ─────────────────────────────────────────
generate_rollback() {
  local user="$1"
  local user_home
  user_home=$(eval echo "~$user")
  local current_shell
  current_shell=$(getent passwd "$user" | cut -d: -f7)

  cat >> "$ROLLBACK_SCRIPT" << EOF
# ── Rollback: $user ──────────────────────────────────────────────────────────
echo "Rolling back $user..."
# Restore default shell
chsh -s "${current_shell}" "${user}" 2>/dev/null || usermod -s "${current_shell}" "${user}" 2>/dev/null || true
# Restore .zshrc from backup
if [[ -f "${BACKUP_DIR}/${user}_zshrc_${TIMESTAMP}.bak" ]]; then
  cp "${BACKUP_DIR}/${user}_zshrc_${TIMESTAMP}.bak" "${user_home}/.zshrc"
  chown "${user}:${user}" "${user_home}/.zshrc"
  echo "Restored .zshrc from backup"
fi
# Remove OMZ (optional -- uncomment to fully remove)
# rm -rf "${user_home}/.oh-my-zsh" "${user_home}/.zshrc.pre-oh-my-zsh"
# Remove Atuin (optional)
# rm -rf "${user_home}/.atuin"
echo "Rollback complete for $user -- re-login to apply"
EOF

  log_info "Rollback instructions added for $user"
}

# ── Main: process one user ───────────────────────────────────────────────────
process_user() {
  local user="$1"

  if ! id "$user" &>/dev/null; then
    log_err "User '$user' does not exist -- skipping"
    return 1
  fi

  log_info "===================================================="
  log_info "Processing user: $user"
  log_info "===================================================="

  local user_home
  user_home=$(eval echo "~$user")

  if [[ ! -d "$user_home" ]]; then
    log_err "Home directory $user_home does not exist -- skipping"
    return 1
  fi

  # Generate per-user rollback before making changes
  generate_rollback "$user"

  # Execute in dependency order
  install_zsh                       # Step 1: install ZSH (global)
  set_default_shell "$user"         # Step 2: set as default shell
  install_ohmyzsh "$user"           # Step 3: OMZ (must be before plugins)
  install_plugins "$user"           # Step 4: clone plugins into $ZSH_CUSTOM
  write_zshrc "$user"               # Step 5: write .zshrc config
  install_atuin "$user"             # Step 6: install Atuin
  validate_install "$user"          # Step 7: validate everything
}

# ── Entry point ──────────────────────────────────────────────────────────────
main() {
  parse_args "$@"

  log_info "zshenv-install v${ZSHENV_VERSION} -- $(date)"
  log_info "Timestamp: $TIMESTAMP"

  if [[ $EUID -ne 0 ]]; then
    log_warn "Not running as root -- some features may fail (chsh, usermod)"
  fi

  # Preflight: required dependencies
  check_dependencies

  # Distro check
  check_distro

  # Create backup directory
  BACKUP_DIR="/root/.zshenv-backups/${TIMESTAMP}"
  mkdir -p "$BACKUP_DIR"
  log_ok "Backup directory: $BACKUP_DIR"

  # Create rollback script
  ROLLBACK_SCRIPT="$BACKUP_DIR/rollback.sh"
  cat > "$ROLLBACK_SCRIPT" << 'HEADER'
#!/usr/bin/env bash
# =============================================================================
# rollback.sh -- Auto-generated rollback for zshenv-install
# Generated: TIMESTAMP
# =============================================================================
set -euo pipefail
echo "Starting rollback..."
HEADER
  sed -i "s/TIMESTAMP/$TIMESTAMP/" "$ROLLBACK_SCRIPT"

  # Resolve target users
  resolve_users

  # Process each user
  local failed=0
  for user in "${TARGET_USERS[@]}"; do
    process_user "$user" || ((failed++))
  done

  # Finalize rollback script
  echo 'echo "Rollback complete."' >> "$ROLLBACK_SCRIPT"
  chmod +x "$ROLLBACK_SCRIPT"

  # Summary
  log_info "===================================================="
  log_info "Summary"
  log_info "===================================================="
  log_ok "Users processed: ${#TARGET_USERS[@]} (failed: $failed)"
  log_ok "Backups: $BACKUP_DIR"
  log_ok "Rollback: $ROLLBACK_SCRIPT"
  log_info "To rollback: sudo bash $ROLLBACK_SCRIPT"
  log_info "To reload shell: exec zsh (or logout and login)"

  if [[ $failed -gt 0 ]]; then
    log_err "$failed user(s) had errors -- check rollback script"
    return 1
  fi

  log_ok "All done! Users should re-login or run: exec zsh"
}

main "$@"
